{{define "ui.field" -}}
{{- $id := ui_id "ui.field" .ID .Name -}}
{{- $label := ui_required "ui.field" "Label" .Label -}}
{{- $desc := ui_describedby $id .Hint .Error -}}
{{- $control := ui_or (ui_variant .Control "textarea" "select") "input" -}}
<div class="ui-field">
<label class="ui-field-label" for="{{$id}}">{{$label}}</label>
{{- if eq $control "textarea"}}
<textarea class="ui-textarea" id="{{$id}}"{{with ui_str .Name}} name="{{.}}"{{end}}{{with ui_str .Rows}} rows="{{.}}"{{end}}{{with ui_str .Placeholder}} placeholder="{{.}}"{{end}}{{with $desc}} aria-describedby="{{.}}"{{end}}{{if .Error}} aria-invalid="true"{{end}}{{if .Required}} required{{end}}{{if .Disabled}} disabled{{end}}>{{ui_str .Value}}</textarea>
{{- else if eq $control "select"}}
<select class="ui-select" id="{{$id}}"{{with ui_str .Name}} name="{{.}}"{{end}}{{with $desc}} aria-describedby="{{.}}"{{end}}{{if .Error}} aria-invalid="true"{{end}}{{if .Required}} required{{end}}{{if .Disabled}} disabled{{end}}>
{{- range .Options}}<option value="{{ui_str .Value}}"{{if ui_selected $.Value .Value}} selected{{end}}>{{ui_str .Label}}</option>{{end -}}
</select>
{{- else}}
<input class="ui-input" id="{{$id}}" type="{{ui_or (ui_variant .Type "email" "password" "number" "search" "tel" "url" "date") "text"}}"{{with ui_str .Name}} name="{{.}}"{{end}}{{with ui_str .Value}} value="{{.}}"{{end}}{{with ui_str .Placeholder}} placeholder="{{.}}"{{end}}{{with ui_str .Autocomplete}} autocomplete="{{.}}"{{end}}{{with $desc}} aria-describedby="{{.}}"{{end}}{{if .Error}} aria-invalid="true"{{end}}{{if .Required}} required{{end}}{{if .Disabled}} disabled{{end}}>
{{- end}}
{{- with ui_str .Hint}}
<p class="ui-field-hint" id="{{$id}}-hint">{{.}}</p>
{{- end}}
{{- with ui_str .Error}}
<p class="ui-field-error" id="{{$id}}-error">{{.}}</p>
{{- end}}
</div>
{{- end}}
